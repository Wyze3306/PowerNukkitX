<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <TerminalConsole name="Console">
            <PatternLayout
                    pattern="%cyan{%d{HH:mm:ss}} [%yellow{%t}] [%style{%highlight{%level}{STYLE=Logback}}] %minecraftFormatting{%msg}%n"/>
            <Filters>
                <RegexFilter regex=".*Reading file /sys/class/net/.*" onMatch="DENY" onMismatch="ACCEPT"/>
            </Filters>
        </TerminalConsole>
        <RollingRandomAccessFile name="File" fileName="logs/server.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss} [%t] %level - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
                <!-- Roll by size too, so a flood of log lines ends up in several files instead of one -->
                <SizeBasedTriggeringPolicy size="64 MB"/>
            </Policies>
            <!-- Old logs are never deleted here: they are kept until someone decides otherwise -->
            <DefaultRolloverStrategy max="32"/>
            <Filters>
                <RegexFilter regex=".*Reading file /sys/class/net/.*" onMatch="DENY" onMismatch="ACCEPT"/>
            </Filters>
        </RollingRandomAccessFile>
    </Appenders>
    <Loggers>
        <AsyncRoot level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </AsyncRoot>
        <!-- Clients trigger these at will, an item stack request packet alone up to 128 of them:
             warnings and errors are rate limited, debug output is left alone -->
        <Logger name="org.powernukkitx.inventory.request">
            <Filters>
                <ThresholdFilter level="WARN" onMatch="NEUTRAL" onMismatch="ACCEPT"/>
                <BurstFilter level="ERROR" rate="5" maxBurst="50"/>
            </Filters>
        </Logger>
        <Logger name="org.powernukkitx.network.process.handler">
            <Filters>
                <ThresholdFilter level="WARN" onMatch="NEUTRAL" onMismatch="ACCEPT"/>
                <BurstFilter level="ERROR" rate="5" maxBurst="50"/>
            </Filters>
        </Logger>
        <!--    disable useless debug log foreign library    -->
        <Logger name="oshi.hardware" level="info"/>
        <Logger name="oshi" level="info"/>
        <Logger name="org.jose4j" level="info"/>
        <Logger name="io.netty.channel.nio" level="info"/>
        <!-- Filter out "Reading file" messages specifically -->
        <Logger name="oshi.software.os.linux" level="info"/>
        <Logger name="oshi.hardware.platform.linux" level="info"/>
    </Loggers>
</Configuration>